{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.scode"
        },
        {
          "path": "$HOME/.scode/**"
        },
        {
          "path": "/opt/homebrew"
        },
        {
          "path": "/usr/local/Homebrew"
        }
      ]
    }
  ]
}
