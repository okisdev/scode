{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/*"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.scode"
        },
        {
          "path": "$HOME/.scode/*"
        },
        {
          "path": "$HOME/.scode/**"
        },
        {
          "path": "/opt/homebrew"
        },
        {
          "path": "/usr/local/Homebrew"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.scode/*"
        },
        {
          "path": "$HOME/.scode/**"
        },
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude/*"
        },
        {
          "path": "$HOME/.claude/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.scode/*"
        },
        {
          "path": "$HOME/.scode/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/.scode"
        },
        {
          "path": "$HOME/.scode/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.github.com/*"
        }
      ]
    }
  ]
}
